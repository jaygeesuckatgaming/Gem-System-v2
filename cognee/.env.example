# LLM Configuration (Ollama)
LLM_PROVIDER="ollama"
LLM_MODEL="gemma4:31b-cloud"
LLM_ENDPOINT="http://localhost:11434"
LLM_API_KEY="ollama"

# Embedding Configuration (Ollama)
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_ENDPOINT="http://localhost:11434/api/embed"
EMBEDDING_API_KEY="ollama"
EMBEDDING_DIMENSIONS="768"

# Tokenizer for Ollama embeddings
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"

# Paths
DATA_ROOT_DIRECTORY="C:/Users/YOUR_USERNAME/Documents/AI/Gem-System-v2/cognee_data"
SYSTEM_ROOT_DIRECTORY="C:/Users/YOUR_USERNAME/Documents/AI/Gem-System-v2/cognee_system"

# Skip connection test
COGNEE_SKIP_CONNECTION_TEST="true"
AUTO_FEEDBACK="false"
CACHING="true"
ENABLE_BACKEND_ACCESS_CONTROL="false"
